@model TrainingSession
@{ ViewData["Title"] = "Delete Training Session"; }

<h5 class="mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Training Session</h5>
<div class="card p-4" style="max-width:500px">
    <p>Delete the <strong>@Model.Module</strong> session for <strong>@Model.Company?.Name</strong> on @Model.TrainingDate.ToString("yyyy-MM-dd")? This cannot be undone.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
