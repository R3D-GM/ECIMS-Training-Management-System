@model Trainer
@{ ViewData["Title"] = "Add Trainer"; }

<h5 class="mb-3"><i class="bi bi-person-badge"></i> Add Trainer</h5>
<div class="card p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3"><label class="form-label" asp-for="Name"></label><input asp-for="Name" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="Position"></label><input asp-for="Position" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="Department"></label><input asp-for="Department" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="Email"></label><input asp-for="Email" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div>
        <button type="submit" class="btn btn-brand">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
