@model IEnumerable<UserListItemViewModel>
@{ ViewData["Title"] = "User Management"; ViewData["Subtitle"] = "Manage login accounts for all roles"; }

<div class="panel">
    <div class="panel-head">
        <div class="panel-title"><i class="bi bi-person-gear"></i> User Management</div>
        <a asp-action="Create" class="btn btn-brand btn-sm"><i class="bi bi-plus-lg"></i> New User</a>
    </div>

    <div class="table-responsive">
    <table class="table mb-0">
        <thead><tr><th>Full Name</th><th>Email</th><th>Role</th><th>Action</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="fw-semibold">@u.FullName</td>
                <td>@u.Email</td>
                <td><span class="badge badge-status-scheduled">@Roles.Display(u.Role)</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn icon-btn btn-outline-brand" title="Edit"><i class="bi bi-pencil"></i></a>
                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this user account?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn icon-btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
