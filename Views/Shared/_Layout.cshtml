@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TCS.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ECIMS | RedCloud ICT Solutions</title>
    <link rel="icon" type="image/png" href="~/images/aleke.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var isAuthed = SignInManager.IsSignedIn(User);
}
@if (!isAuthed)
{
    @RenderBody()
}
else
{
    var role = TCS.Models.Roles.All.FirstOrDefault(r => User.IsInRole(r)) ?? "";
    var currentUser = await UserManager.GetUserAsync(User);
    var currentAction = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentActionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var myNotifications = await Db.Notifications
        .Where(n => n.UserId == currentUser!.Id || (n.UserId == null && n.TargetRole == role))
        .OrderByDescending(n => n.CreatedDate)
        .Take(6)
        .ToListAsync();
    var unreadCount = await Db.Notifications
        .CountAsync(n => !n.IsRead && (n.UserId == currentUser!.Id || (n.UserId == null && n.TargetRole == role)));

    bool IsActive(params string[] controllers) => controllers.Contains(currentAction);
    <div class="app-shell">
        <nav class="sidebar" id="sidebar">
            <div class="brand">
                <img src="~/images/aleke.png" alt="RedCloud" class="brand-mark-img" />
                <div class="brand-text">
                    <div class="t1">RedCloud</div>
                    <div class="t2">ICT SOLUTIONS</div>
                </div>
            </div>

            <div class="nav-scroll">
                <div class="nav-section-title">Main</div>
                <a class="nav-link @(IsActive("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>

                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.Consultant or TCS.Models.Roles.ProjectManager or TCS.Models.Roles.ContactPerson or TCS.Models.Roles.Trainer)
                {
                    <a class="nav-link @(IsActive("TrainingSessions") ? "active" : "")" asp-controller="TrainingSessions" asp-action="Index"><i class="bi bi-calendar3"></i> Training Schedule</a>
                }
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.Consultant or TCS.Models.Roles.ProjectManager)
                {
                    <a class="nav-link @(IsActive("SessionRequests") ? "active" : "")" asp-controller="SessionRequests" asp-action="Index"><i class="bi bi-clipboard-check"></i> Session Request</a>
                }
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.Consultant or TCS.Models.Roles.Trainer)
                {
                    <a class="nav-link @(IsActive("TrainingAssignments") ? "active" : "")" asp-controller="TrainingAssignments" asp-action="Index"><i class="bi bi-person-check"></i> Training Assignment</a>
                }
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.TransportManager)
                {
                    <a class="nav-link @(currentAction == "TransportAssignments" && currentActionName != "PendingApprovals" && currentActionName != "CreateConsolidated" ? "active" : "")" asp-controller="TransportAssignments" asp-action="Index"><i class="bi bi-truck"></i> Transport Assignment</a>
                    <a class="nav-link @(currentAction == "TransportAssignments" && (currentActionName == "PendingApprovals" || currentActionName == "CreateConsolidated") ? "active" : "")" asp-controller="TransportAssignments" asp-action="PendingApprovals"><i class="bi bi-check2-square"></i> Transport Approvals</a>
                }
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.Consultant or TCS.Models.Roles.ProjectManager or TCS.Models.Roles.ContactPerson)
                {
                    <a class="nav-link @(IsActive("UatProjects") ? "active" : "")" asp-controller="UatProjects" asp-action="Index"><i class="bi bi-clipboard2-check"></i> UAT Projects</a>
                }
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.CustomerService)
                {
                    <a class="nav-link @(IsActive("CustomerService") ? "active" : "")" asp-controller="CustomerService" asp-action="Index"><i class="bi bi-headset"></i> Customer Service</a>
                }

                <div class="nav-section-title">Management</div>
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.Consultant or TCS.Models.Roles.ProjectManager or TCS.Models.Roles.Trainer)
                {
                    <a class="nav-link @(IsActive("Trainers") ? "active" : "")" asp-controller="Trainers" asp-action="Index"><i class="bi bi-easel"></i> Trainers</a>
                }
                @if (role == TCS.Models.Roles.Admin)
                {
                    <a class="nav-link @(IsActive("Trainees") ? "active" : "")" asp-controller="Trainees" asp-action="Index"><i class="bi bi-people"></i> Trainees</a>
                }
                <a class="nav-link @(currentAction == "TrainingConfirmations" && currentActionName != "PendingApproval" ? "active" : "")" asp-controller="TrainingConfirmations" asp-action="Index"><i class="bi bi-pencil-square"></i> Client Confirmation</a>
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.ProjectManager)
                {
                    <a class="nav-link @(currentAction == "TrainingConfirmations" && currentActionName == "PendingApproval" ? "active" : "")" asp-controller="TrainingConfirmations" asp-action="PendingApproval"><i class="bi bi-check2-square"></i> Batch Approvals</a>
                }
                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.TransportManager)
                {
                    <a class="nav-link @(IsActive("Vehicles") ? "active" : "")" asp-controller="Vehicles" asp-action="Index"><i class="bi bi-truck-front"></i> Vehicles</a>
                }
                @if (role == TCS.Models.Roles.Admin)
                {
                    <a class="nav-link @(IsActive("Users") ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> User Management</a>
                }

                @if (role is TCS.Models.Roles.Admin or TCS.Models.Roles.Consultant or TCS.Models.Roles.ProjectManager or TCS.Models.Roles.TransportManager)
                {
                    <div class="nav-section-title">Analytics</div>
                    <a class="nav-link @(IsActive("Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line-fill"></i> Reports &amp; Analytics</a>
                }
            </div>

            <div class="dropdown">
                <button class="profile-foot btn w-100 border-0 rounded-0 text-start" type="button" data-bs-toggle="dropdown" style="border-top:1px solid var(--border) !important">
                    <div class="avatar">@(currentUser?.FullName.Substring(0,1).ToUpper() ?? "A")</div>
                    <div class="who">
                        <div class="name">@currentUser?.FullName</div>
                        <div class="role">@TCS.Models.Roles.Display(role)</div>
                    </div>
                    <i class="bi bi-chevron-up text-muted"></i>
                </button>
                <ul class="dropdown-menu w-100 shadow-sm">
                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-2"></i>Settings</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger px-0"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="main-content">
            <div class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-md-none me-2" onclick="document.getElementById('sidebar').classList.toggle('show')">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <div class="page-subtitle">@ViewData["Subtitle"]</div>
                        }
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="search-box"><i class="bi bi-search"></i> Search anything...</div>
                    <div class="dropdown">
                        <button class="bell-btn btn p-0" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                            @if (unreadCount > 0)
                            {
                                <span class="dot"></span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="width:340px">
                            <li class="px-3 py-2 d-flex justify-content-between align-items-center">
                                <span class="fw-bold small">Notifications</span>
                                @if (unreadCount > 0)
                                {
                                    <span class="badge badge-status-pending">@unreadCount new</span>
                                }
                            </li>
                            <li><hr class="dropdown-divider m-0" /></li>
                            @if (!myNotifications.Any())
                            {
                                <li class="px-3 py-3 text-muted small text-center">You're all caught up.</li>
                            }
                            else
                            {
                                @foreach (var n in myNotifications)
                                {
                                    <li>
                                        <a class="dropdown-item small py-2 @(n.IsRead ? "" : "fw-semibold")" asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id">
                                            @n.Message
                                            <div class="text-muted" style="font-size:.72rem">@n.CreatedDate.ToString("MMM dd, HH:mm")</div>
                                        </a>
                                    </li>
                                }
                            }
                            <li><hr class="dropdown-divider m-0" /></li>
                            <li><a class="dropdown-item text-center small" style="color:#7A1518" asp-controller="Notifications" asp-action="Index">View all notifications</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="page-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"] <button class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"] <button class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/signature-pad.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
