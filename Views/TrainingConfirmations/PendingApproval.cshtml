@model IEnumerable<TrainingConfirmation>
@{ ViewData["Title"] = "Batch Approvals"; }

<h5 class="mb-3"><i class="bi bi-check2-square"></i> Pending Manager Approvals</h5>
<p class="text-muted small">Confirmations that have been signed by both Trainer and Client, awaiting your batch approval.</p>

@if (!Model.Any())
{
    <p class="text-muted">Nothing pending approval right now.</p>
}
else
{
    <form asp-action="ApproveBatch" method="post">
        @Html.AntiForgeryToken()
        <div class="table-responsive">
        <table class="table table-hover bg-white align-middle">
            <thead><tr><th></th><th>#</th><th>Company</th><th>Module</th><th>Trainer</th><th>Signed Date</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><input type="checkbox" name="confirmationIds" value="@c.Id" class="form-check-input" /></td>
                    <td>#@c.Id.ToString("D5")</td>
                    <td>@c.TrainingSession?.Company?.Name</td>
                    <td>@c.TrainingSession?.Module</td>
                    <td>@c.TrainingSession?.Trainer?.Name</td>
                    <td>@c.DecidedDate?.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <div class="mb-3" style="max-width:500px">
            <label class="form-label small">Approval Notes (optional)</label>
            <textarea name="notes" class="form-control" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-brand">Approve Selected</button>
    </form>
}
