@model TrainingConfirmation
@{ ViewData["Title"] = "New Confirmation"; var session = (TrainingSession)ViewBag.Session; }

<h5 class="mb-3"><i class="bi bi-file-earmark-check"></i> New Client Training Confirmation</h5>
<div class="alert alert-light border small">
    Creating a confirmation for <strong>@session?.Module</strong> &mdash; @session?.Company?.Name on @session?.TrainingDate.ToString("yyyy-MM-dd")
</div>

<div class="card p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TrainingSessionId" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="ContactPersonName">Client Authorized Signatory</label>
            <input asp-for="ContactPersonName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Remarks"></label>
            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="e.g. Conformed to Training Section!!"></textarea>
        </div>
        <button type="submit" class="btn btn-brand">Create Confirmation</button>
        <a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@session?.Id" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
