@model TrainingConfirmation
@{
    Layout = null;
    var session = Model.TrainingSession;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Confirmation #@Model.Id.ToString("D5")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background:#f4f5f7; font-family:'Segoe UI',Arial,sans-serif; }
        .cert-page { max-width:900px; margin:2rem auto; background:#fff; border:1px solid #ddd; padding:2.2rem; }
        .cert-title { color:#7A1518; font-weight:800; letter-spacing:.03em; text-align:center; }
        .cert-header-bar { border-bottom:3px solid #7A1518; padding-bottom:.75rem; margin-bottom:1rem; }
        .sec-title { background:#0d2b52; color:#fff; padding:.35rem .7rem; font-weight:600; font-size:.85rem; }
        .sec-body { border:1px solid #ddd; border-top:none; padding:.6rem .8rem; }
        table.info td { padding:.25rem .5rem; font-size:.9rem; }
        table.info td.label { font-weight:600; width:40%; background:#fafafa; }
        .sign-box { text-align:center; padding-top:2rem; }
        .sign-box img { max-height:70px; }
        @@media print { .no-print { display:none !important; } body { background:#fff; } .cert-page { border:none; margin:0; padding:0; } }
    </style>
</head>
<body>
<div class="text-center no-print py-2">
    <button class="btn btn-brand btn-sm" style="background:#7A1518;color:#fff;border:none" onclick="window.print()">🖨 Print / Save as PDF</button>
</div>
<div class="cert-page">
    <div class="d-flex justify-content-between align-items-center cert-header-bar">
        <div class="fw-bold" style="color:#7A1518">REDCloud <span class="text-dark d-block" style="font-size:.7rem">ICT Solutions</span></div>
        <h4 class="cert-title mb-0">CLIENT TRAINING CONFIRMATION</h4>
        <div style="width:120px"></div>
    </div>

    <div class="d-flex justify-content-between small mb-3">
        <span><strong>Confirmation ID:</strong> #@Model.Id.ToString("D5")</span>
        <span><strong>Date Submitted:</strong> @Model.SubmittedDate.ToString("MMMM d, yyyy, h:mm tt")</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6">
            <div class="sec-title">Company Information</div>
            <div class="sec-body">
                <table class="info w-100">
                    <tr><td class="label">Company Name</td><td>@session?.Company?.Name</td></tr>
                    <tr><td class="label">Branch</td><td>@session?.Company?.Branch</td></tr>
                    <tr><td class="label">Training Location</td><td>@session?.Location</td></tr>
                    <tr><td class="label">Training Date</td><td>@session?.TrainingDate.ToString("yyyy-MM-dd")</td></tr>
                </table>
            </div>
        </div>
        <div class="col-6">
            <div class="sec-title">Training Details</div>
            <div class="sec-body">
                <table class="info w-100">
                    <tr><td class="label">Module</td><td>@session?.Module</td></tr>
                    <tr><td class="label">Duration</td><td>@session?.Duration hrs</td></tr>
                    <tr><td class="label">Start Time</td><td>@session?.StartTime</td></tr>
                    <tr><td class="label">End Time</td><td>@session?.EndTime</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6">
            <div class="sec-title">Trainer Information</div>
            <div class="sec-body">
                <table class="info w-100">
                    <tr><td class="label">Trainer Name</td><td>@session?.Trainer?.Name</td></tr>
                    <tr><td class="label">Position</td><td>@session?.Trainer?.Position</td></tr>
                </table>
            </div>
        </div>
        <div class="col-6">
            <div class="sec-title">Remarks</div>
            <div class="sec-body" style="min-height:70px">@Model.Remarks</div>
        </div>
    </div>

    <div class="sec-title">Trainee Information</div>
    <div class="sec-body mb-4">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light"><tr><th>#</th><th>Trainee Name</th><th>Position</th><th>Phone</th><th>Signature</th></tr></thead>
            <tbody>
            @{ int i = 1; }
            @if (session != null)
            {
                foreach (var t in session.Trainees)
                {
                    <tr><td>@(i++)</td><td>@t.Name</td><td>@t.Position</td><td>@t.Phone</td><td></td></tr>
                }
            }
            @for (int pad = (session?.Trainees.Count ?? 0); pad < 2; pad++)
            {
                <tr><td>@(i++)</td><td>&nbsp;</td><td></td><td></td><td></td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="row">
        <div class="col-6 sign-box">
            <div class="fw-semibold">Client Authorized Signature</div>
            <div class="small text-muted">I confirm that the training has been successfully delivered and received.</div>
            @if (!string.IsNullOrEmpty(Model.ContactPersonSignaturePath))
            {
                <div><img src="@Model.ContactPersonSignaturePath" /></div>
                <div class="small mt-1">@Model.ContactPersonName</div>
            }
            <div class="small text-muted mt-2">Put the stamp</div>
        </div>
        <div class="col-6 sign-box">
            <div class="fw-semibold">Trainer Signature</div>
            <div class="small text-muted">@session?.Trainer?.Name</div>
            @if (!string.IsNullOrEmpty(Model.TrainerSignaturePath))
            {
                <div><img src="@Model.TrainerSignaturePath" /></div>
            }
        </div>
    </div>
</div>
</body>
</html>
