@{ ViewData["Title"] = "Forgot Password"; Layout = "_Layout"; }

<div class="login-page">
    <div class="login-shell" style="max-width:460px">
        <div class="login-form-side" style="min-width:100%">
            <div class="login-brand">
                <div class="brand-mark">R</div>
                <div class="name">ECIMS<span class="dot">.</span></div>
            </div>

            <h2>Forgot Password</h2>
            <p class="text-muted mb-4">Enter your account email and we'll take you to reset it.</p>

            @if (ViewBag.NotFound == true)
            {
                <div class="alert alert-warning">No account found with that email.</div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <input name="email" type="email" required class="form-control form-control-lg" placeholder="admin@company.com" autofocus />
                </div>
                <button type="submit" class="btn btn-brand btn-lg w-100"><i class="bi bi-send"></i> Send Reset Link</button>
            </form>

            <p class="text-center mt-3 mb-0"><a asp-action="Login">Back to Login</a></p>
        </div>
    </div>
</div>
