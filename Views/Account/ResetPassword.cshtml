@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; Layout = "_Layout"; }

<div class="login-page">
    <div class="login-shell" style="max-width:460px">
        <div class="login-form-side" style="min-width:100%">
            <div class="login-brand">
                <div class="brand-mark">R</div>
                <div class="name">ECIMS<span class="dot">.</span></div>
            </div>

            <h2>Reset Password</h2>
            <p class="text-muted mb-4">Choose a new password for your account.</p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control form-control-lg" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold" asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-brand btn-lg w-100"><i class="bi bi-check-lg"></i> Reset Password</button>
            </form>
        </div>
    </div>
</div>
