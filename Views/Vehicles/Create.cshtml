@model Vehicle
@{ ViewData["Title"] = "Add Vehicle"; }

<h5 class="mb-3"><i class="bi bi-truck"></i> Add Vehicle</h5>
<div class="card p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3"><label class="form-label" asp-for="PlateNumber"></label><input asp-for="PlateNumber" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="Model"></label><input asp-for="Model" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="Capacity"></label><input asp-for="Capacity" type="number" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="DriverName"></label><input asp-for="DriverName" class="form-control" /></div>
        <div class="mb-3"><label class="form-label" asp-for="DriverPhone"></label><input asp-for="DriverPhone" class="form-control" /></div>
        <div class="mb-3">
            <label class="form-label" asp-for="Status"></label>
            <select asp-for="Status" class="form-select">
                <option value="Available">Available</option>
                <option value="In Use">In Use</option>
                <option value="Maintenance">Maintenance</option>
            </select>
        </div>
        <button type="submit" class="btn btn-brand">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
