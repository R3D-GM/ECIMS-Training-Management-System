@model CustomerDecideViewModel
@{ ViewData["Title"] = "Review Decision"; ViewData["Subtitle"] = $"{Model.CompanyName} / {Model.BranchName}"; }

<div class="panel">
    <div class="panel-head"><div class="panel-title"><i class="bi bi-clipboard2-check"></i> UAT Checklist Summary</div></div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-4">
            <div class="stat-card"><div class="stat-value">@Model.PassedCount</div><div class="stat-label">Passed</div></div>
        </div>
        <div class="col-4">
            <div class="stat-card"><div class="stat-value">@Model.FailedCount</div><div class="stat-label">Failed</div></div>
        </div>
        <div class="col-4">
            <div class="stat-card"><div class="stat-value">@Model.NAItems</div><div class="stat-label">N/A</div></div>
        </div>
    </div>

    @if (Model.Changes.Any())
    {
        <h6 class="fw-bold mb-2">Failed / Flagged Items</h6>
        <div class="table-responsive mb-3">
        <table class="table mb-0">
            <thead><tr><th>Item</th><th>Comment</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Changes)
            {
                <tr>
                    <td>@c.TestDescription @if (c.IsFlagged) { <span class="badge badge-status-declined ms-1">Flagged</span> }</td>
                    <td>@c.Comment</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
    else
    {
        <div class="alert alert-success">Everything passed - no issues to review.</div>
    }

    <div class="d-flex gap-2">
        <form asp-action="Accept" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="attemptId" value="@Model.AttemptId" />
            <button type="submit" class="btn btn-brand"><i class="bi bi-check-circle"></i> Accept &amp; Sign</button>
        </form>
        <form asp-action="Decline" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="attemptId" value="@Model.AttemptId" />
            <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason for decline (optional)" style="width:260px" />
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Decline</button>
        </form>
    </div>
</div>
