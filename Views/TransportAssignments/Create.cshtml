@model TransportAssignment
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Assign Vehicle";
    var sessions = (List<TrainingSession>)ViewBag.Sessions;
    var vehicles = (List<Vehicle>)ViewBag.Vehicles;
}

<h5 class="mb-3"><i class="bi bi-signpost-split"></i> Assign Vehicle to Training</h5>
<div class="card p-4" style="max-width:600px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label class="form-label">Training Session</label>
            <select asp-for="TrainingSessionId" class="form-select"
                    asp-items="@(new SelectList(sessions.Select(s => new { s.Id, Label = $"{s.Module} - {s.Company!.Name} ({s.TrainingDate:yyyy-MM-dd})" }), "Id", "Label"))">
                <option value="">-- Select Training Session --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Vehicle</label>
            <select asp-for="VehicleId" class="form-select"
                    asp-items="@(new SelectList(vehicles.Select(v => new { v.Id, Label = $"{v.PlateNumber} - {v.Model} ({v.DriverName})" }), "Id", "Label"))">
                <option value="">-- Select Vehicle --</option>
            </select>
        </div>
        <div class="mb-3"><label class="form-label" asp-for="Notes"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>

        <button type="submit" class="btn btn-brand">Save Assignment</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
